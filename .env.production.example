# ==============================================================================
# KosMatch Jakarta - Production Environment Template
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=4000
JWT_SECRET=super-secret-jwt-signing-key-min-32-chars

# CORS Origin (URL frontend produksi di Vercel / domain kustom)
CORS_ORIGIN=https://kosmatch-web.vercel.app

# Database PostgreSQL Produksi (Neon Serverless Pooler)
# Wajib sertakan parameter sslmode=require dan channel_binding=require
DATA_STORE=postgres
DATABASE_URL="postgresql://username:password@ep-sample-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# AI Chatbot LLM (Google AI Studio Gemini)
USE_MOCK_AI=false
GEMINI_API_KEY=AIzaSyYourProductionGoogleAiStudioKey
LLM_MODEL=gemini-2.5-flash

# Commute Provider (OSRM OpenStreetMap Jakarta Routing)
COMMUTE_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
