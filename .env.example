# API server
PORT=4000
JWT_SECRET=change-me-in-production

# Providers (Milestone 3: RAG AI Google AI Studio + OSRM Routing)
# Set USE_MOCK_AI=false untuk memakai AI RAG Google AI Studio (otomatis fallback ke mock jika offline/key kosong)
USE_MOCK_AI=false
# COMMUTE_PROVIDER: "osrm" (rute jalan nyata Jakarta via OpenStreetMap) atau "mock"
COMMUTE_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org

# Konfigurasi AI LLM RAG (Google AI Studio - https://aistudio.google.com/apikey)
# 👉 TARUH API KEY GOOGLE AI STUDIO ANDA (AIzaSy...) DI BARIS INI:
GEMINI_API_KEY=AIzaSy-isi-api-key-google-ai-studio-anda-di-sini
# Model Gemini dari Google AI Studio (default: gemini-2.5-flash, otomatis fallback ke gemini-2.0-flash)
LLM_MODEL=gemini-2.5-flash

# Database Store: "postgres" atau "memory"
DATA_STORE=postgres

# Allowed CORS origin for the web app (dev)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Connection String (Neon / Supabase / Localhost)
# Contoh Neon: postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/kosmatch?sslmode=require
# Contoh Localhost: postgresql://postgres:postgres@localhost:5432/kosmatch?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kosmatch?schema=public"
