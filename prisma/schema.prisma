datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Kos {
  id                String     @id
  namaKos           String
  area              String
  region            String
  kecamatan         String
  tipe              String
  hargaSewa         Int
  fasilitas         String
  rating            Float?
  jumlahUlasan      Int?       @default(0)
  transaksiBerhasil Int?       @default(0)
  luasM2            Float?
  listrikTermasuk   Boolean    @default(false)
  sisaKamar         Float?
  deskripsi         String?
  lat               Float
  lng               Float
  dalamJakarta      Boolean    @default(true)
  fotoColor         String?    @default("#B8C4D6")
  ownerId           String?    @default("owner-bu-sari")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  bookmarks         Bookmark[]

  @@index([area])
  @@index([hargaSewa])
  @@index([region])
  @@index([kecamatan])
  @@index([ownerId])
}

model User {
  id           String     @id @default(uuid())
  nama         String
  email        String     @unique
  passwordHash String
  role         String     @default("tenant")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  bookmarks    Bookmark[]
}

model Destination {
  id        String   @id
  nama      String
  kategori  String
  latitude  Float
  longitude Float
  aliases   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  kosId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kos  Kos  @relation(fields: [kosId], references: [id], onDelete: Cascade)

  @@unique([userId, kosId])
  @@index([userId])
  @@index([kosId])
}

model ChatHistory {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  pesan      String
  sentAt     DateTime @default(now())

  @@index([senderId, receiverId])
}
